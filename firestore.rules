rules_version = '2';

// REBUILD FITNESS — only the owners and staff logins created by an owner can read/write gym
// data. A self-created account (Firebase sign-up) gets nothing. Nothing is public except a bill
// opened by its secret link. Member / trainer app logins reach only their own chat and ticks
// (bottom of this file). Each staff login only reaches the features the owner switched on
// (Staff page → Login & features), the same switches the app uses to show pages.
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner accounts. Keep in sync with OWNER_EMAILS in src/constants/owners.ts.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['rebuildfitnesskkd@gmail.com', 'admin@elevategym.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/staffAccess/$(request.auth.uid);
    }
    // Staff login created by an owner (server writes /staffAccess/{uid}); switched off = no access.
    function isStaffLogin() {
      return request.auth != null && exists(accessPath()) && get(accessPath()).data.active == true;
    }
    function isStaff() {
      return isOwner() || isStaffLogin();
    }
    // Feature switch, e.g. can('finance'). "All features" (admin) logins have every feature.
    function can(feature) {
      return isOwner() || (isStaffLogin()
        && (get(accessPath()).data.admin == true || feature in get(accessPath()).data.permissions));
    }

    // Each staff login's features. Owners change them; the staff member can read their own.
    match /staffAccess/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Front-desk data every staff login uses.
    match /{collection}/{docId} {
      allow read, write: if isStaff() && collection in [
        'inquiries', 'memberships', 'followups', 'invoices', 'attendance',
        'workoutPlans', 'workoutAssignments', 'dietPlans', 'dietAssignments',
        'bookings', 'groupClasses', 'classEnrollments',
        'renewalNotifications', 'birthdayNotifications', 'absenceNotifications', 'paymentDueNotifications',
        'notifications', 'automationActivities', 'whatsappMessages', 'ptAssignments',
        'payments', 'enrollments', 'importBatches', 'leadLogs', 'biometricCommands',
        'memberCalls'
      ];
    }

    // Members: everyone adds and edits; deleting needs "Delete members".
    match /clients/{id} {
      allow read, create, update: if isStaff();
      allow delete: if can('deleteMembers');
    }

    // Settings: bill / member numbers change on every joining; the rest needs "Settings".
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if (id == 'counters' && isStaff()) || can('settings');
    }

    match /packages/{id} {
      allow read: if isStaff();
      allow write: if can('packages');
    }
    match /ptPackages/{id} {
      allow read: if isStaff();
      allow write: if can('packages');
    }
    // Trainers are staff with the role "Trainer": the Staff page keeps their profile in step.
    match /trainers/{id} {
      allow read: if isStaff();
      allow write: if can('packages') || can('staff');
    }

    match /biometricDevices/{id} {
      allow read: if isStaff();
      allow write: if can('devices');
    }

    // Money: only "Income & expenses".
    // Expenses and the daily cash handover are entered by the front desk (Day book).
    match /expenses/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /expenseActivities/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /manualIncome/{id} {
      allow read, write: if can('finance');
    }
    match /cashDays/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /staffPayments/{id} {
      allow read, write: if can('finance');
    }
    // Created when PT is sold (any front desk); seen and paid out by finance.
    match /trainerPayouts/{id} {
      allow create: if isStaff();
      allow read: if can('finance') || can('packages');
      allow update: if can('finance');
      allow delete: if can('finance') || can('deleteMembers') || can('deleteBills');
    }

    // Recycle Bin: what was deleted waits here, stamped with who deleted it and when, until the
    // owner restores it or deletes it forever. Whoever may delete puts things in (under their own
    // account); a staff login reads and can undo only its own; the owner sees everything.
    // (A new entry is looked up before it's written: reading one that doesn't exist yet is fine.)
    // A login given the Recycle Bin page sees and restores everything, like the owner.
    match /recycleBin/{id} {
      allow create: if isStaff() && request.resource.data.deletedByUid == request.auth.uid;
      allow read: if can('recycleBin')
        || (isStaff() && (resource == null || resource.data.deletedByUid == request.auth.uid));
      allow update, delete: if can('recycleBin')
        || (isStaff() && resource.data.deletedByUid == request.auth.uid);
    }
    match /recycleBinItems/{id} {
      allow create: if isStaff() && request.resource.data.deletedByUid == request.auth.uid;
      allow read: if can('recycleBin')
        || (isStaff() && (resource == null || resource.data.deletedByUid == request.auth.uid));
      allow delete: if can('recycleBin')
        || (isStaff() && resource.data.deletedByUid == request.auth.uid);
    }

    // Staff: names for the counsellor list. The owner, or a login given the Staff page, adds and
    // edits staff; only the owner links logins (loginUid / loginEmail) or deletes. Pay is
    // finance-only (staffPrivate).
    match /staff/{id} {
      allow read: if isStaff();
      allow create: if isOwner()
        || (can('staff') && request.resource.data.get('loginUid', '') == ''
          && request.resource.data.get('loginEmail', '') == '');
      allow update: if isOwner()
        || (can('staff')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loginUid', 'loginEmail']));
      allow delete: if isOwner();
    }
    match /staffPrivate/{id} {
      allow read, write: if isOwner() || can('finance');
    }
    // Written by the fingerprint device (server) or marked by hand.
    match /staffAttendance/{id} {
      allow read: if can('attendance') || can('finance');
      allow create: if can('attendance');
      allow update, delete: if isOwner();
    }
    // Present / half day / absent / paid leave set by the admin or receptionist.
    match /staffDayMarks/{id} {
      allow read: if can('attendance') || can('finance');
      allow write: if can('attendance');
    }
    // Paid leaves allowed per staff per month: set by the owner / finance.
    match /staffPayroll/{id} {
      allow read: if can('attendance') || can('finance');
      allow write: if can('finance');
    }

    // Tamper-proof activity log. The app adds a line in the same write as each change: create
    // only, as the signed-in account itself, stamped with the server clock. Nobody can edit or
    // delete a line from the app (the server adds "System (automatic)" lines with admin access).
    match /auditLogs/{entryId} {
      allow read: if can('activity');
      allow create: if isStaff()
        && request.resource.data.actorType == 'app_user'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Users found on a fingerprint machine ("Read users"): written by the server only. Every desk
    // can read them, so a new member is never given a machine ID the old software already used.
    match /deviceUsers/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Each member's arrival time per day (first thumb), for the member app: staff and server.
    match /memberVisits/{id} {
      allow read, write: if isStaff();
    }

    // Their fingerprint templates, and the ones kept for door-lock restore: server only.
    match /deviceUserTemplates/{id} {
      allow read, write: if false;
    }

    match /biometricTemplates/{clientId} {
      allow read, write: if false;
    }

    // Member ID numbers in use (one record per ID), so two desks can never give out the same
    // number. Freed when the member is deleted.
    match /memberIds/{id} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if can('deleteMembers');
    }

    // WhatsApp announcements cost money (Marketing): only logins with that switch.
    match /announcements/{id} {
      allow read, write: if can('announcements');
    }

    match /whatsappWebhookEvents/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /publicInvoices/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------ member app and trainer app
    // Their logins are made by the server (src/server/portal.ts) and carry a claim:
    // { portal: 'member', clientId } or { portal: 'trainer', trainerId }. They are never staff
    // (no staffAccess, not an owner email), so none of the rules above let them in. Everything
    // else they see comes from the server; only these two things are read / written directly.
    function portalKind() {
      return request.auth != null ? request.auth.token.get('portal', '') : '';
    }
    function myClientId() {
      return request.auth.token.get('clientId', '');
    }
    function myTrainerId() {
      return request.auth.token.get('trainerId', '');
    }
    function isMemberApp(clientId) {
      return portalKind() == 'member' && myClientId() == clientId;
    }
    function isTrainerApp() {
      return portalKind() == 'trainer' && myTrainerId() != '';
    }
    function chatPath(clientId) {
      return /databases/$(database)/documents/chats/$(clientId);
    }
    // The member's current PT trainer: the server keeps chats/{clientId}.trainerId up to date.
    function isTrainerOf(clientId) {
      return isTrainerApp() && exists(chatPath(clientId))
        && get(chatPath(clientId)).data.trainerId == myTrainerId();
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function lastMessageBy(who) {
      return request.resource.data.lastFrom == who
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFrom', 'lastAt']);
    }

    // Member ↔ PT trainer chat. The server opens it (with the trainer) when PT is active.
    match /chats/{clientId} {
      allow read: if isOwner() || isMemberApp(clientId)
        || (isTrainerApp() && resource.data.trainerId == myTrainerId());
      allow update: if (isMemberApp(clientId)
          && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'memberReadAt']) && lastMessageBy('member'))
        || (isTrainerApp() && resource.data.trainerId == myTrainerId()
          && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'trainerReadAt']) && lastMessageBy('trainer'));
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner() || isMemberApp(clientId) || isTrainerOf(clientId);
        allow create: if request.resource.data.keys().hasOnly(['from', 'name', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.at == request.time
          && ((isMemberApp(clientId) && exists(chatPath(clientId)) && request.resource.data.from == 'member')
            || (isTrainerOf(clientId) && request.resource.data.from == 'trainer'));
        allow update, delete: if false;
      }
    }

    // What a member ticked each day (planLogs/{clientId}_{YYYY-MM-DD}): only they write their own.
    match /planLogs/{logId} {
      allow read: if isStaff()
        || (portalKind() == 'member' && logId.matches(myClientId() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
      allow create, update: if portalKind() == 'member'
        && request.resource.data.clientId == myClientId()
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && logId == myClientId() + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['clientId', 'date', 'workoutDay', 'workoutDone', 'dietDone', 'updatedAt'])
        && request.resource.data.workoutDay is int
        && request.resource.data.workoutDone is list && request.resource.data.workoutDone.size() <= 60
        && request.resource.data.dietDone is list && request.resource.data.dietDone.size() <= 60;
      allow delete: if can('deleteMembers');
    }

    // Encrypted copies of staff / trainer passwords: the server only (owner's "Show password").
    match /loginVault/{id} {
      allow read, write: if false;
    }

    // Phones that get member-app / trainer-app notifications, and the gym's push keys: server only.
    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }
    match /serverSecrets/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
