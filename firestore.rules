rules_version = '2';

// REBUILD FITNESS — only the owners and staff logins created by an owner can read/write gym
// data. A self-created account (Firebase sign-up) gets nothing. Nothing is public except a bill
// opened by its secret link. Member / trainer app logins reach only their own chat and ticks
// (bottom of this file). Each staff login only reaches the features the owner switched on
// (Staff page → Login & features), the same switches the app uses to show pages.
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner accounts. Keep in sync with OWNER_EMAILS in src/constants/owners.ts.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['rebuildfitnesskkd@gmail.com', 'admin@elevategym.com'];
    }
    function accessPath() {
      return /databases/$(database)/documents/staffAccess/$(request.auth.uid);
    }
    // Staff login created by an owner (server writes /staffAccess/{uid}); switched off = no access.
    function isStaffLogin() {
      return request.auth != null && exists(accessPath()) && get(accessPath()).data.active == true;
    }
    function isStaff() {
      return isOwner() || isStaffLogin();
    }
    // Feature switch, e.g. can('finance'). "All features" (admin) logins have every feature.
    function can(feature) {
      return isOwner() || (isStaffLogin()
        && (get(accessPath()).data.admin == true || feature in get(accessPath()).data.permissions));
    }

    // Each staff login's features. Owners change them; the staff member can read their own.
    match /staffAccess/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Front-desk data every staff login uses.
    match /{collection}/{docId} {
      allow read, write: if isStaff() && collection in [
        'inquiries', 'followups', 'attendance',
        'workoutPlans', 'workoutAssignments', 'dietPlans', 'dietAssignments',
        'bookings', 'groupClasses', 'classEnrollments',
        'renewalNotifications', 'birthdayNotifications', 'absenceNotifications', 'paymentDueNotifications',
        'notifications', 'automationActivities', 'whatsappMessages', 'importBatches', 'leadLogs',
        'memberCalls'
      ];
    }

    // Members: everyone adds and edits; deleting needs "Delete members".
    match /clients/{id} {
      allow read, create, update: if isStaff();
      allow delete: if can('deleteMembers');
    }

    // ---- Money. Today in India as a number (20261017). The Day Book closes every day before the
    // 1st of last month (cashOpenFrom in src/services/finance.service.ts): cash there never changes,
    // not even from the owner's browser (only the server can). Old-software money never was drawer
    // cash: Finance looks after it on any date.
    function istNow() { return request.time + duration.value(330, 'm'); }
    function numOf(ts) { return ts.year() * 10000 + ts.month() * 100 + ts.day(); }
    function todayNum() { return numOf(istNow()); }
    function openFromNum() {
      return istNow().month() == 1
        ? (istNow().year() - 1) * 10000 + 1201
        : istNow().year() * 10000 + (istNow().month() - 1) * 100 + 1;
    }
    function isDay(s) { return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function dayNum(s) { return int(s.replace('-', '')); }
    function isOld(d) { return d.get('oldSoftware', false) == true; }
    // Cash facts of a payment: what the Day Book adds up.
    function payOpen(d) { return isDay(d.paymentDate) && dayNum(d.paymentDate) >= openFromNum(); }
    // A desk PC's clock may run a little ahead: tomorrow is the latest day drawer cash can be
    // dated. (Old-software money brought over may sit on a plan's later start day.)
    function payShapeOk(d) {
      return d.amount is number && isDay(d.paymentDate)
        && (isOld(d) || dayNum(d.paymentDate) <= numOf(istNow() + duration.value(1, 'd')))
        && d.get('kind', 'initial') in ['initial', 'balance', 'refund'];
    }
    function typedToday() {
      return resource.data.get('createdAt', null) is timestamp
        && numOf(resource.data.createdAt + duration.value(330, 'm')) == todayNum();
    }
    // Billing may change today's money (dated today, or typed today); Finance any open-month money.
    // Who typed it and when never change (the undo below relies on them).
    function payEditOk() {
      let a = resource.data;
      let b = request.resource.data;
      let keys = b.diff(a).affectedKeys();
      return !keys.hasAny(['createdAt', 'createdByUid'])
        && (!keys.hasAny(['amount', 'method', 'paymentDate', 'kind', 'oldSoftware'])
          || (payShapeOk(b)
            && (!keys.hasAny(['kind', 'oldSoftware']) || can('finance'))
            && ((isOld(a) && isOld(b))
              ? can('finance')
              : payOpen(a) && payOpen(b) && !isOld(a) && !isOld(b)
                && (b.amount >= 0 || can('finance'))
                && (can('finance')
                  || (can('billing') && (dayNum(a.paymentDate) == todayNum() || typedToday()))))));
    }
    match /payments/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && payShapeOk(request.resource.data)
        && (isOld(request.resource.data)
          // Finance enters it; a member, plan or bin entry put back brings it back.
          ? (can('finance') || can('deleteMembers') || can('deletePlans') || can('recycleBin'))
          : payOpen(request.resource.data)
            && (request.resource.data.amount >= 0 || can('finance')));
      allow update: if isStaff() && payEditOk();
      allow delete: if isStaff() && (
        (isOld(resource.data) && (can('finance') || can('deleteMembers') || can('deletePlans')))
        || (payOpen(resource.data) && !isOld(resource.data) && (
          can('finance') || can('deleteBills') || can('deleteMembers') || can('deletePlans')
          // Restore cancellation takes its refund back out (only ever adds cash back).
          || (resource.data.amount < 0 && resource.data.get('kind', '') == 'refund'
            && resource.data.get('cancelId', '') != '')
          // Undo right after collecting a balance: your own, typed today (never a sale's payment).
          || (resource.data.get('kind', '') == 'balance'
            && resource.data.get('createdByUid', '') == request.auth.uid && typedToday())
          // Edit payment joins a Cash + UPI pair back into one (same rights as editing it).
          || (resource.data.get('splitId', '') != '' && can('billing')
            && (dayNum(resource.data.paymentDate) == todayNum() || typedToday())))));
    }
    function billDeleter() {
      return can('deleteBills') || can('deleteMembers') || can('deletePlans');
    }
    // Bills: the number, the secret link and the bill date are fixed once made. An old bill made
    // before payments were recorded one by one (paymentsTracked not true) counts its amountPaid as
    // income on its bill date: only Finance may lower that or mark a bill untracked.
    function billEditOk() {
      let a = resource.data;
      let b = request.resource.data;
      let keys = b.diff(a).affectedKeys();
      return !keys.hasAny(['invoiceNumber', 'publicToken', 'invoiceDate'])
        && (!keys.hasAny(['paymentsTracked']) || b.get('paymentsTracked', false) == true
          || can('finance'))
        && (a.get('paymentsTracked', false) == true || !keys.hasAny(['amountPaid'])
          || b.get('amountPaid', 0) >= a.get('amountPaid', 0) || can('finance'));
    }
    match /invoices/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.get('invoiceNumber', '') is string;
      allow update: if isStaff() && billEditOk();
      allow delete: if billDeleter();
    }
    match /memberships/{id} {
      allow read, create, update: if isStaff();
      allow delete: if can('deletePlans') || can('deleteMembers');
    }
    match /ptAssignments/{id} {
      allow read, create, update: if isStaff();
      allow delete: if can('deletePlans') || can('deleteMembers');
    }
    match /enrollments/{id} {
      allow read, create, update: if isStaff();
      allow delete: if can('deletePlans') || can('deleteMembers') || can('deleteBills');
    }

    // Bill numbers: a desk may only take the next number (+1), in this year's or last year's
    // series (a new series starts at 1).
    function counterStepOk(a, b) {
      let k1 = 'invoiceSeq' + string(istNow().year());
      let k0 = 'invoiceSeq' + string(istNow().year() - 1);
      let keys = b.diff(a).affectedKeys();
      return keys.hasOnly([k1, k0, 'updatedAt'])
        && (!keys.hasAny([k1]) || b[k1] == a.get(k1, 0) + 1)
        && (!keys.hasAny([k0]) || b[k0] == a.get(k0, 0) + 1);
    }
    // Settings: the bill counter moves on every sale; the rest needs "Settings". The health form
    // (what members agree to) is the owner's own text.
    function settingsWriter(id) {
      return (id == 'healthForm' && isOwner()) || (id != 'healthForm' && can('settings'));
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow create: if settingsWriter(id)
        || (id == 'counters' && isStaff() && counterStepOk({}, request.resource.data));
      allow update: if settingsWriter(id)
        || (id == 'counters' && isStaff() && counterStepOk(resource.data, request.resource.data));
      allow delete: if settingsWriter(id);
    }

    // Health forms members accepted (src/server/portal-health.ts writes the app ones). The desk
    // can record one received on paper and take it back (Undo); nobody edits an acceptance.
    match /healthForms/{id} {
      allow read: if can('members');
      allow create: if can('members')
        && request.resource.data.keys().hasOnly(['clientId', 'clientName', 'version', 'title',
          'answers', 'consent', 'signedName', 'method', 'by', 'note', 'signedOn', 'createdAt', 'updatedAt'])
        && request.resource.data.method == 'paper'
        && request.resource.data.clientId is string && request.resource.data.clientId.size() > 0
        && request.resource.data.answers == []
        && request.resource.data.version is int
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.signedOn is string
        && request.resource.data.signedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow update: if false;
      allow delete: if can('members') && resource.data.method == 'paper';
    }

    // Body progress: all of one member's entries in one doc (src/lib/body-progress.ts). The member
    // and trainer apps write through the server; staff write here, the whole list in one go.
    match /bodyProgress/{clientId} {
      allow read: if can('members');
      allow create, update: if can('members')
        && request.resource.data.keys().hasOnly(['clientId', 'entries', 'updatedAt'])
        && request.resource.data.clientId == clientId
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 400;
      allow delete: if false;
    }

    match /packages/{id} {
      allow read: if isStaff();
      allow write: if can('packages');
    }
    match /ptPackages/{id} {
      allow read: if isStaff();
      allow write: if can('packages');
    }
    // Trainers are staff with the role "Trainer": the Staff page keeps their profile in step.
    match /trainers/{id} {
      allow read: if isStaff();
      allow write: if can('packages') || can('staff');
    }

    // Machine commands. The app queues only these, with the exact text it builds; everything
    // else (deletes, template restores, imports) is made by the server. The server checks again
    // before anything reaches the machine (src/server/biometric-guard.ts). In these patterns
    // '\t' is the regex escape for a tab (the app's commands are tab-separated).
    function cmdCreateOk(d) {
      return d.status == 'pending'
        && d.biometricUserId is string && d.biometricUserId.matches('[A-Za-z0-9]{0,24}')
        && d.command is string
        && ((d.type in ['door_check', 'forget', 'bin_off', 'staff_off', 'photo_sync'] && d.command == '')
          || (d.type == 'user_upsert' && d.biometricUserId.matches('[0-9]{1,9}')
            && d.command.matches('DATA UPDATE USERINFO PIN=' + d.biometricUserId
              + '\tName=[^\t\r\n]{0,40}\tPri=0\tPasswd=\tCard=\tGrp=1\tTZ=0000000100000000\tVerify=0'))
          || (d.type == 'enroll_fp' && d.biometricUserId.matches('[0-9]{1,9}')
            && d.command.matches('ENROLL_FP PIN=' + d.biometricUserId + '\tFID=5\tRETRY=3\tOVERWRITE=1')));
    }
    match /biometricCommands/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && cmdCreateOk(request.resource.data);
      // Withdrawing a registration still waiting for the machine is the only change (never a door
      // change: a lock-out must reach the machine).
      allow update: if isStaff() && resource.data.get('door', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status in ['pending', 'sent'] && request.resource.data.status == 'cancelled';
      allow delete: if can('deleteMembers') || can('devices');
    }

    match /biometricDevices/{id} {
      allow read: if isStaff();
      allow write: if can('devices');
    }

    // Money: only "Income & expenses".
    // Expenses and the daily cash handover are entered by the front desk (Day book).
    match /expenses/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /expenseActivities/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /manualIncome/{id} {
      allow read, write: if can('finance');
    }
    match /cashDays/{id} {
      allow read, write: if can('finance') || can('daybook');
    }
    match /staffPayments/{id} {
      allow read, write: if can('finance');
    }
    // Created when PT is sold (any front desk); seen and paid out by finance. Whoever may delete
    // them with a plan, bill or member reads them to do so.
    match /trainerPayouts/{id} {
      allow create: if isStaff();
      allow read: if can('finance') || can('packages') || can('deletePlans') || can('deleteBills')
        || can('deleteMembers');
      allow update: if can('finance');
      allow delete: if can('finance') || can('deleteMembers') || can('deleteBills')
        || can('deletePlans');
    }

    // CFO page (Finance): the settings are saved from the page and every field is type-checked;
    // the numbers, the full lists and the AI summaries are written by the server only.
    function cfoSettingsOk() {
      let d = request.resource.data;
      let allowed = [
          'openingBalance', 'openingDate', 'atRiskDays', 'renewalDays', 'newMemberMinVisits',
          'ptMinVisits', 'runwayWarnMonths', 'graceDays', 'aiEnabled', 'language',
          'updatedAt', 'updatedBy'];
      // A save may only add or change these fields. A stray older field never blocks a save
      // (and a save may drop it).
      return (resource == null
          ? d.keys().hasOnly(allowed)
          : d.diff(resource.data).addedKeys().hasOnly(allowed)
            && d.diff(resource.data).changedKeys().hasOnly(allowed))
        && d.keys().hasAll([
          'openingBalance', 'openingDate', 'atRiskDays', 'renewalDays', 'newMemberMinVisits',
          'ptMinVisits', 'runwayWarnMonths', 'graceDays', 'aiEnabled', 'language',
          'updatedAt', 'updatedBy'])
        && (d.openingBalance == null || d.openingBalance is number)
        && d.openingDate is string
        && (d.openingDate == '' || d.openingDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.atRiskDays is number && d.atRiskDays >= 0
        && d.renewalDays is number && d.renewalDays >= 0
        && d.newMemberMinVisits is number && d.newMemberMinVisits >= 0
        && d.ptMinVisits is number && d.ptMinVisits >= 0
        && d.runwayWarnMonths is number && d.runwayWarnMonths >= 0
        && d.graceDays is number && d.graceDays >= 0
        && d.aiEnabled is bool
        && d.language in ['English', 'Telugu', 'Hindi']
        && d.updatedAt is timestamp
        && d.updatedBy is string && d.updatedBy.size() <= 200;
    }
    match /cfoSettings/{id} {
      allow read: if can('finance');
      allow create, update: if can('finance') && id == 'main' && cfoSettingsOk();
      allow delete: if false;
    }
    match /cfoReports/{id} {
      allow read: if can('finance');
      allow write: if false;
    }
    match /cfoBriefs/{id} {
      allow read: if can('finance');
      allow write: if false;
    }

    // Recycle Bin: what was deleted waits here, stamped with who deleted it and when, until the
    // owner restores it or deletes it forever. Whoever may delete puts things in (under their own
    // account); a staff login reads and can undo only its own; the owner sees everything.
    // (A new entry is looked up before it's written: reading one that doesn't exist yet is fine.)
    // A login given the Recycle Bin page sees and restores everything, like the owner.
    // Who may put a record of each kind in the bin: whoever may delete it. Restoring writes the
    // copy back with the restorer's rights (often the owner's), so a copy planted by a login
    // without that right must not get in.
    function canBin(c) {
      return (c in ['staff', 'staffPrivate'] && isOwner())
        || (c in ['payments', 'invoices', 'publicInvoices', 'trainerPayouts']
          && (can('deleteBills') || can('deleteMembers') || can('deletePlans') || can('finance')))
        || (c in ['memberships', 'ptAssignments', 'enrollments'] && (can('deleteMembers') || can('deletePlans')))
        || (c == 'clients' && can('deleteMembers'))
        || (c in ['trainers', 'packages'] && can('deletePackages'))
        // A salary's pay record goes with its expense: staff pay is Finance's.
        || (c == 'staffPayments' && can('finance'))
        || (!(c in ['staff', 'staffPrivate', 'payments', 'invoices', 'publicInvoices', 'trainerPayouts',
            'memberships', 'ptAssignments', 'enrollments', 'clients', 'trainers', 'packages',
            'staffPayments']) && isStaff());
    }
    // Each bin entry's section needs that section's delete right (DELETE_FEATURE_OF in
    // src/constants/features.ts); "bills" also takes Finance (Remove payment). A restore acts on
    // the entry's section (logins back on for "staff"), so it must be a section the login may delete.
    function binSectionOk(s) {
      return (s == 'staff' && isOwner())
        || (s == 'members' && can('deleteMembers'))
        || (s == 'leads' && can('deleteLeads'))
        || (s == 'bills' && (can('deleteBills') || can('finance')))
        || (s == 'packages' && can('deletePackages'))
        || (s == 'expenses' && can('deleteExpenses'))
        || (s == 'plans' && can('deletePlans'))
        || (!(s in ['staff', 'members', 'leads', 'bills', 'packages', 'expenses', 'plans']) && isStaff());
    }
    match /recycleBin/{id} {
      allow create: if isStaff() && request.resource.data.deletedByUid == request.auth.uid
        && binSectionOk(request.resource.data.section);
      allow read: if can('recycleBin')
        || (isStaff() && (resource == null || resource.data.deletedByUid == request.auth.uid));
      allow update, delete: if can('recycleBin')
        || (isStaff() && resource.data.deletedByUid == request.auth.uid);
    }
    // An item is a copy of one record the app moves to the bin, written back to its own path on
    // restore: never a login, feature switch, setting or machine command (restoring runs with the
    // restorer's rights), and only from a login that may delete that kind of record (canBin).
    function binnable(d) {
      return d.collection in ['attendance', 'automationActivities', 'birthdayNotifications', 'bookings', 'classEnrollments', 'clients', 'dietAssignments', 'enrollments', 'expenses', 'followups', 'inquiries', 'invoices', 'leadLogs', 'memberships', 'notifications', 'payments', 'ptAssignments', 'publicInvoices', 'renewalNotifications', 'staff', 'staffPrivate', 'trainerPayouts', 'trainers', 'whatsappMessages', 'workoutAssignments', 'packages', 'absenceNotifications', 'paymentDueNotifications', 'staffPayments']
        && d.docId is string && !d.docId.matches('.*/.*')
        && d.path == d.collection + '/' + d.docId;
    }
    match /recycleBinItems/{id} {
      allow create: if isStaff() && request.resource.data.deletedByUid == request.auth.uid
        && binnable(request.resource.data) && canBin(request.resource.data.collection);
      allow read: if can('recycleBin')
        || (isStaff() && (resource == null || resource.data.deletedByUid == request.auth.uid));
      allow delete: if can('recycleBin')
        || (isStaff() && resource.data.deletedByUid == request.auth.uid);
    }

    // Staff: names for the counsellor list. The owner, or a login given the Staff page, adds and
    // edits staff; only the owner links logins (loginUid / loginEmail) or deletes. Pay is
    // finance-only (staffPrivate).
    match /staff/{id} {
      allow read: if isStaff();
      allow create: if isOwner()
        || (can('staff') && request.resource.data.get('loginUid', '') == ''
          && request.resource.data.get('loginEmail', '') == '');
      allow update: if isOwner()
        || (can('staff')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loginUid', 'loginEmail']));
      allow delete: if isOwner();
    }
    match /staffPrivate/{id} {
      allow read, write: if isOwner() || can('finance');
    }
    // Written by the fingerprint device (server) or marked by hand.
    match /staffAttendance/{id} {
      allow read: if can('attendance') || can('finance');
      allow create: if can('attendance');
      allow update, delete: if isOwner();
    }
    // Present / half day / absent / paid leave set by the admin or receptionist.
    match /staffDayMarks/{id} {
      allow read: if can('attendance') || can('finance');
      allow write: if can('attendance');
    }
    // Paid leaves allowed per staff per month: set by the owner / finance.
    match /staffPayroll/{id} {
      allow read: if can('attendance') || can('finance');
      allow write: if can('finance');
    }

    // Tamper-proof activity log. The app adds a line in the same write as each change: create
    // only, as the signed-in account itself, stamped with the server clock. Nobody can edit or
    // delete a line from the app (the server adds "System (automatic)" lines with admin access).
    match /auditLogs/{entryId} {
      allow read: if can('activity');
      allow create: if isStaff()
        && request.resource.data.actorType == 'app_user'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Users found on a fingerprint machine ("Read users"): written by the server only. Every desk
    // can read them, so a new member is never given a machine ID the old software already used.
    match /deviceUsers/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Each member's arrival time per day (first thumb), for the member app: staff and server.
    match /memberVisits/{id} {
      allow read, write: if isStaff();
    }

    // Their fingerprint templates, and the ones kept for door-lock restore: server only.
    match /deviceUserTemplates/{id} {
      allow read, write: if false;
    }

    match /biometricTemplates/{clientId} {
      allow read, write: if false;
    }

    // Member ID numbers in use (one record per ID), so two desks can never give out the same
    // number. Freed when the member is deleted.
    match /memberIds/{id} {
      allow read, create: if isStaff();
      allow update: if false;
      allow delete: if can('deleteMembers');
    }

    // WhatsApp announcements cost money (Marketing): only logins with that switch.
    match /announcements/{id} {
      allow read, write: if can('announcements');
    }

    // "Paid in the old software" corrections (money moved out of this app's collections) and
    // their copies for Undo: Income & expenses only. Never deleted.
    match /oldSoftwareMoves/{id} {
      allow read, create, update: if can('finance');
      allow delete: if false;
    }

    // WhatsApp chats (members' messages and replies): written only by the server.
    match /waChats/{waId} {
      allow read: if can('whatsappChats');
      allow write: if false;
      match /messages/{messageId} {
        allow read: if can('whatsappChats');
        allow write: if false;
      }
    }

    match /whatsappWebhookEvents/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /publicInvoices/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if billDeleter();
    }

    // ------------------------------------------------------ member app and trainer app
    // Their logins are made by the server (src/server/portal.ts) and carry a claim:
    // { portal: 'member', clientId } or { portal: 'trainer', trainerId }. They are never staff
    // (no staffAccess, not an owner email), so none of the rules above let them in. Everything
    // else they see comes from the server; only these two things are read / written directly.
    function portalKind() {
      return request.auth != null ? request.auth.token.get('portal', '') : '';
    }
    function myClientId() {
      return request.auth.token.get('clientId', '');
    }
    function myTrainerId() {
      return request.auth.token.get('trainerId', '');
    }
    function isMemberApp(clientId) {
      return portalKind() == 'member' && myClientId() == clientId;
    }
    function isTrainerApp() {
      return portalKind() == 'trainer' && myTrainerId() != '';
    }
    function chatPath(clientId) {
      return /databases/$(database)/documents/chats/$(clientId);
    }
    // The member's current PT trainer: the server keeps chats/{clientId}.trainerId up to date.
    function isTrainerOf(clientId) {
      return isTrainerApp() && exists(chatPath(clientId))
        && get(chatPath(clientId)).data.trainerId == myTrainerId();
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function lastMessageBy(who) {
      return request.resource.data.lastFrom == who
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFrom', 'lastAt']);
    }

    // Member ↔ PT trainer chat. The server opens it (with the trainer) when PT is active.
    match /chats/{clientId} {
      allow read: if isOwner() || isMemberApp(clientId)
        || (isTrainerApp() && resource.data.trainerId == myTrainerId());
      allow update: if (isMemberApp(clientId)
          && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'memberReadAt']) && lastMessageBy('member'))
        || (isTrainerApp() && resource.data.trainerId == myTrainerId()
          && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'trainerReadAt']) && lastMessageBy('trainer'));
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner() || isMemberApp(clientId) || isTrainerOf(clientId);
        allow create: if request.resource.data.keys().hasOnly(['from', 'name', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.at == request.time
          && ((isMemberApp(clientId) && exists(chatPath(clientId)) && request.resource.data.from == 'member')
            || (isTrainerOf(clientId) && request.resource.data.from == 'trainer'));
        allow update, delete: if false;
      }
    }

    // What a member ticked each day (planLogs/{clientId}_{YYYY-MM-DD}): only they write their own.
    match /planLogs/{logId} {
      allow read: if isStaff()
        || (portalKind() == 'member' && logId.matches(myClientId() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
      allow create, update: if portalKind() == 'member'
        && request.resource.data.clientId == myClientId()
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && logId == myClientId() + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['clientId', 'date', 'workoutDay', 'workoutDone', 'dietDone', 'updatedAt'])
        && request.resource.data.workoutDay is int
        && request.resource.data.workoutDone is list && request.resource.data.workoutDone.size() <= 60
        && request.resource.data.dietDone is list && request.resource.data.dietDone.size() <= 60;
      allow delete: if can('deleteMembers');
    }

    // Encrypted copies of staff / trainer passwords: the server only (owner's "Show password").
    match /loginVault/{id} {
      allow read, write: if false;
    }

    // Phones that get member-app / trainer-app notifications, and the gym's push keys: server only.
    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }
    match /serverSecrets/{id} {
      allow read, write: if false;
    }

    // The old software's data (Backup page): original files, one record per phone, the list.
    // Server only: owners upload, logins with "Backup" download, joining looks up one phone.
    match /oldDataFiles/{document=**} {
      allow read, write: if false;
    }
    match /oldMembers/{key} {
      allow read, write: if false;
    }
    match /oldDataIndex/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
