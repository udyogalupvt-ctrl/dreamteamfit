rules_version = '2';

// REBUILD FITNESS — only signed-in staff can read/write gym data. Nothing is public.
// Ready for role-based permissions later (e.g. a /staff/{uid} doc with a role field).
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null;
    }

    match /{collection}/{docId} {
      allow read, write: if isStaff() && collection in [
        'packages', 'inquiries', 'clients', 'memberships',
        'followups', 'invoices', 'attendance', 'settings',
        'workoutPlans', 'workoutAssignments', 'dietPlans', 'dietAssignments',
        'bookings', 'groupClasses', 'classEnrollments',
        'expenses', 'expenseActivities', 'biometricDevices',
        'renewalNotifications', 'birthdayNotifications', 'notifications', 'automationActivities',
        'whatsappMessages', 'ptPackages', 'trainers', 'ptAssignments', 'payments',
        'enrollments', 'trainerPayouts', 'manualIncome', 'importBatches', 'leadLogs',
        'biometricCommands'
      ];
    }

    // Tamper-proof activity log: written only by the server (Cloud Function), never by the app.
    match /auditLogs/{entryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Stored fingerprint templates for door-lock restore: server only, no browser access at all.
    match /biometricTemplates/{clientId} {
      allow read, write: if false;
    }

    match /whatsappWebhookEvents/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /publicInvoices/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
