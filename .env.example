# Copy to .env and fill in. .env is git-ignored; never commit real keys or tokens.
# ==========================================
# Firebase Configuration
# ==========================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=leadsmanage-1f7cd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leadsmanage-1f7cd
VITE_FIREBASE_STORAGE_BUCKET=leadsmanage-1f7cd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1019581568447
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ==========================================
# Cloudinary Configuration
# ==========================================

VITE_CLOUDINARY_CLOUD_NAME=dcoimqij
VITE_CLOUDINARY_UPLOAD_PRESET=levelupingup

# ==========================================
# App Configuration
# ==========================================

VITE_APP_NAME=Rebuild Fitness

# ==========================================
# Server (Vercel → Project → Settings → Environment Variables). No VITE_ prefix: never sent to
# the browser. Used by the app's own /api and /iclock routes (src/server).
# ==========================================

# Firebase service account JSON (Firebase console → Project settings → Service accounts →
# Generate new private key). Paste the whole JSON, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=

# WhatsApp Cloud API · number +91 79896 17553 (Dream Team Services) · permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=1112943475226121
WHATSAPP_BUSINESS_ACCOUNT_ID=1467855488121062
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
# From Meta App → Settings → Basic → App secret (needed only for delivery ticks via the webhook)
WHATSAPP_APP_SECRET=
# Any long random text; enter the same value in Meta → WhatsApp → Configuration → Webhook
WHATSAPP_VERIFY_TOKEN=

# Any long random text. Vercel sends it to /api/cron/* so nobody else can trigger reminders.
CRON_SECRET=
