# Copied to .env by setup.sh. Keep .env only on the server (it is never committed).

# From Cloudflare → Zero Trust → Networks → Tunnels → your tunnel (the long token, see README.md).
CLOUDFLARE_TUNNEL_TOKEN=
# The address you gave the tunnel, e.g. wa.yourgym.in (only shown by connect.sh).
PUBLIC_HOSTNAME=

# OpenWA release line (image tag). 0.23 = the tested one.
OPENWA_VERSION=0.23

# Most messages per day from the gym's number: day 1, day 2, … after linking (the last number
# applies from then on). New chats = people the number has never talked to (new members).
DAILY_LIMIT=60,80,100
NEW_CHATS_DAILY_LIMIT=40,50,60
